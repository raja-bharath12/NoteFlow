// Firebase Storage Security Rules for NoteFlow
// Deploy with: firebase deploy --only storage
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── User Avatars ──────────────────────────────────────────────────────
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // Max 5MB
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Document Attachments ──────────────────────────────────────────────
    match /attachments/{documentId}/{allPaths=**} {
      // Any signed-in user who can read the document can download attachments
      allow read: if request.auth != null;
      // Only signed-in users can upload attachments (document permission enforced app-side)
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024  // Max 50MB per file
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('application/.*word.*') ||
          request.resource.contentType.matches('application/.*excel.*') ||
          request.resource.contentType.matches('text/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('audio/.*')
        );
      allow delete: if request.auth != null;
    }
  }
}
